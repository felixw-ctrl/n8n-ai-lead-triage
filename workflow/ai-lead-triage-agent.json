    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = $json.output || {};\nconst steps = $json.intermediateSteps || [];\nconst form = $('Config').item.json;\n\nconst realTools = steps.map(s => s.action?.tool).filter(Boolean);\nconst realUnique = [...new Set(realTools)];\nconst claimed = out.actions_taken || [];\nconst sorted = list => [...new Set(list)].filter(t => t !== 'lookup_contact').sort();\nconst realActions = sorted(realTools);\nconst claimedActions = sorted(claimed);\n\nconst writeTools = ['save_lead','notify_sales','notify_support','notify_partnerships','save_reply_draft'];\nconst categories = ['sales_lead','support','partnership','job_application','spam'];\nconst problems = [];\n\n// Escalation: the agent decides, the workflow enforces the confidence rule\nconst lowConfidence = typeof out.confidence === 'number' && out.confidence < 0.7;\nconst escalated = out.escalated === true || lowConfidence;\nconst escalationReason = (out.escalation_reason || (lowConfidence ? 'Low confidence (' + out.confidence + ')' : ''))\n  .replace(/\\s*No tools were called\\.?/i, '')\n  .trim();\n\nif (!categories.includes(out.category)) problems.push('invalid category');\nif (typeof out.confidence !== 'number' || out.confidence < 0 || out.confidence > 1) problems.push('invalid confidence');\nif (escalated && realTools.some(t => writeTools.includes(t))) problems.push('escalated but also took write actions');\nif (out.category === 'support' && realTools.includes('save_lead')) problems.push('support saved to CRM');\n\nconst dupWrites = writeTools.filter(t => realTools.filter(x => x === t).length > 1);\nif (dupWrites.length) problems.push('write tool called twice: ' + dupWrites.join(', '));\n\nif (JSON.stringify(claimedActions) !== JSON.stringify(realActions)) problems.push('reported actions differ from real tool calls');\n\nconst required = {\n  sales_lead: ['save_lead','notify_sales','save_reply_draft'],\n  partnership: ['save_lead','notify_partnerships','save_reply_draft'],\n  support: ['notify_support','save_reply_draft'],\n  job_application: [],\n  spam: []\n};\nconst expected = escalated ? [] : (required[out.category] || []);\nconst optional = escalated ? [] : ({ sales_lead: ['notify_support'] }[out.category] || []);\nconst realForRules = realActions.filter(t => !optional.includes(t));\nif (JSON.stringify(realForRules) !== JSON.stringify([...expected].sort())) problems.push('tools do not follow the rules (expected: ' + (expected.join(', ') || 'none') + ')');\n\nconst notes = [];\nif (lowConfidence && out.escalated !== true) notes.push('escalated by the confidence rule, not by the agent');\nif (realTools.filter(t => t === 'lookup_contact').length > 1) notes.push('lookup_contact called more than once');\n\nconst sendToHuman = escalated || problems.length > 0;\nconst reviewReason = escalated ? escalationReason : 'Rule check failed: ' + problems.join('; ');\n\nconst routes = {\n  save_lead: 'CRM',\n  notify_sales: '#sales-leads',\n  notify_support: '#support',\n  notify_partnerships: '#partnerships',\n  save_reply_draft: 'Reply draft'\n};\nconst routeList = realUnique.filter(t => routes[t]).map(t => routes[t]);\nif (sendToHuman) routeList.push('#triage-review');\nconst routedTo = routeList.join(', ') || 'logged only';\n\nconst durationSec = form.startedAt ? Math.round((Date.now() - form.startedAt) / 100) / 10 : '';\n\nreturn {\n  name: form.Name,\n  email: form.Email,\n  company: form.Company || '',\n  message: form.Message,\n  category: out.category,\n  confidence: out.confidence,\n  urgency: out.urgency,\n  summary: out.summary,\n  nextStep: out.next_step || '',\n  returningContact: out.is_returning_contact,\n  escalated,\n  escalationReason,\n  toolsUsed: realTools.join(', '),\n  routedTo,\n  ruleCheck: problems.length ? problems.join('; ') : 'ok',\n  notes: notes.join('; '),\n  needsReview: problems.length > 0,\n  sendToHuman,\n  reviewMessage: `🔎 Needs a person: ${reviewReason}\\nFrom: ${form.Name} (${form.Email})\\nSummary: ${out.summary || ''}\\nNext step: ${out.next_step || 'Review this request.'}`,\n  durationSec\n};"
      },
